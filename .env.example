HOST=127.0.0.1
PORT=3000
COMPETITION_TIMEOUT_MS=6000
# Server-side configuration (never commit real credentials)
# Used only when the chain-specific RPC URL below is absent
# ALCHEMY_API_KEY=
# ETHEREUM_RPC_URL=https://your-eth-simulatev1-endpoint
# Optional mapping base slots: chain ID -> token -> uint256 hex slot
# Missing entries use read-only debug_traceCall with fake owners and a server memory cache
# BALANCE_SLOTS={"1":{"0x1111111111111111111111111111111111111111":"0x0"}}
# ZERO_EX_API_KEY=
# ONE_INCH_API_KEY=
# BARTER_API_KEY=
# ENSO_API_KEY=
# HYPERBLOOM_API_KEY=
# OOGABOOGA_API_KEY=
# OKX_API_KEY=
# OKX_SECRET_KEY=
# OKX_API_PASSPHRASE=
# Optional provider metadata/credentials
# BEBOP_API_KEY=
# KYBER_CLIENT_ID=your-application-name
# ODOS_API_KEY=
# OKX_PROJECT_ID=
# Live provider smoke tests (opt in explicitly; never commit real keys)
# METAMATCH_RUN_LIVE_PROVIDER_TESTS=1
# METAMATCH_LIVE_CHAIN_ID=1
# METAMATCH_LIVE_BUY_TOKEN_999=0x<chain-specific-token>
# METAMATCH_LIVE_SELL_TOKEN_999=0x<chain-specific-erc20-token>
# METAMATCH_LIVE_SELL_AMOUNT_999=10000000000000000
